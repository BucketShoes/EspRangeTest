# Project defaults, applied by both idf.py and PlatformIO.
#
# Deliberately a single file rather than a base plus sdkconfig.defaults.<target>: PlatformIO
# does not reliably pick up target-specific defaults, and a setting that silently fails to
# apply is far more expensive to debug than a little redundancy. Everything here is valid on
# C6, C3 and S3 - the only genuine per-target difference is the 802.15.4 radio, and that is
# gated in code via SOC_IEEE802154_SUPPORTED, not by configuration.

# Console on the UART bridge - the port you flash through and the one the ROM bootloader
# already prints to. Getting this wrong sends the app log and any panic backtrace out the
# *other* USB socket, which looks exactly like a silent reboot loop.
# The native USB port stays available as a secondary console, so either cable works.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Hold at the panic instead of rebooting. A backtrace you can read beats a board that
# resets before you finish scrolling.
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y

# The report is the M0 deliverable, so it must not be filtered out by the default log level.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Same partitions.csv that platformio.ini points at, so idf.py and PlatformIO cannot end up
# building against different layouts. A preset here would be ignored by PlatformIO entirely.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Flash size and MMU page size, pinned explicitly.
#
# On the C6 the flash MMU page size is CONFIGURABLE and ESP-IDF derives it from the flash
# size unless told otherwise. The bootloader then checks the app image header against its own
# page size and refuses to run it on a mismatch:
#
#   E cpu_start: Invalid app image header
#
# PlatformIO sets flash size from the board manifest while sdkconfig derives the page size
# separately, so the two can disagree - the same dual-source-of-truth trap as the partition
# table. Pinning both here, and matching board_build.flash_size in platformio.ini, removes
# the derivation entirely.
#
# 4MB on both boards even though the WROOM-1 has 8MB: partitions.csv only needs 3.06MB, and
# one identical layout across both boards is worth more here than the unused headroom.
#
# Only the flash size is pinned. The MMU page size is left to ESP-IDF to derive from it -
# bootloader and app read the same sdkconfig, so they derive the same value and agree. An
# explicit page size here would be one more knob to get wrong, which is how we got here.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# NOTE, learned the hard way: editing this file does NOT change an existing build. PlatformIO
# seeds sdkconfig.<env> from here once, and after that the generated file wins - the build will
# succeed, report nothing, and quietly use the old value. Delete sdkconfig.devkitc /
# sdkconfig.devkitm (both gitignored, both regenerate) after changing anything here, and then
# grep the generated file to confirm the value actually landed.

# Cap the Wi-Fi PHY's transmit power, in the one place that binds before anything transmits.
#
# esp_wifi_set_max_tx_power() cannot be called until after esp_wifi_start(), so there is a
# window of a few milliseconds on every Wi-Fi start - boot included - where the driver is at
# its own default of 20dBm and the SoftAP is already beaconing. This option feeds the PHY power
# table in components/esp_phy/esp32c6/phy_init_data.c, which is loaded at PHY init, so it binds
# earlier than any runtime call can.
#
# The cost, stated plainly: this is a HARD CEILING for the whole build, not a bring-up
# measure. ESP-NOW and Wi-Fi cannot be range-tested above 10dBm while it is set - which matters,
# because ESP-NOW in LR mode currently holds the distance record. Raise this to 20 before a
# field test that needs Wi-Fi at full power. The valid range is 10..20; there is no lower.
#
# It does NOT touch BLE or 802.15.4 - that table is the Wi-Fi rate ladder only - so both of the
# channels currently under investigation still reach 20dBm.
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=10

# Long-running walks: a watchdog trip mid-test would lose the run.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# Keeps the floating point printf formatter out of the image - rt_report deliberately
# formats its one fractional value by hand.
CONFIG_NEWLIB_NANO_FORMAT=y

# ---- BLE (used from M1 onward; set here so the radio config is settled before it matters)
# NimBLE rather than Bluedroid: smaller, and multi-instance extended advertising is well
# supported, which the coded-PHY advert channel depends on.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# Extended advertising is what carries coded PHY. A legacy 1M advert runs alongside it on a
# separate instance, purely so Chrome can discover the board - Chrome's scanner is
# legacy-only and cannot see the coded one.
CONFIG_BT_NIMBLE_EXT_ADV=y
CONFIG_BT_NIMBLE_MAX_EXT_ADV_INSTANCES=2

# Several peers plus the browser, which consumes a peripheral slot on every board it
# connects to - hence the connection manager's slot rotation.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4

# A results line is up to ~66 bytes and each one goes out as a single notification. The
# default 23-byte ATT MTU would truncate them, so ask for a large one up front.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
