# ESP-IDF
build/
# Generated config: idf.py writes sdkconfig, PlatformIO writes sdkconfig.<env> per
# environment. Keep the checked-in defaults, ignore everything generated from them.
/sdkconfig
/sdkconfig.*
!/sdkconfig.defaults
!/sdkconfig.defaults.*
managed_components/
dependencies.lock

# PlatformIO
.pio/
# Machine-local PlatformIO overrides (COM ports etc) - never committed, so they survive
# pulls rather than fighting with the tracked platformio.ini.
*.local.ini

# web
node_modules/
dist/

# editors / OS
.vscode/
.idea/
*.swp
.DS_Store
