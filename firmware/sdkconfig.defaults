# Shared defaults for every target. Board-specific overrides go in
# sdkconfig.defaults.<target> (ESP-IDF merges them automatically).

# Serial output goes over the devkit's native USB, so a report is visible with nothing
# attached but the one cable used for flashing.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The report is the M0 deliverable, so it must not be filtered out by the default log
# level, and it must not stall the loop that produces it.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# No filesystem and no OTA: there is deliberately no flash logging (flash writes stall the
# system, which would be its own contention source), so a single large app partition is
# the right shape. This also fits the 4MB MINI-1 and the 8MB WROOM-1 identically.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Long-running walks: a watchdog trip mid-test would lose the run.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# Keeps the floating point printf formatter out of the image - rt_report deliberately
# formats its one fractional value by hand.
CONFIG_NEWLIB_NANO_FORMAT=y
